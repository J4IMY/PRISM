# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prism

# App URL (used in verification emails)
APP_URL=http://localhost:5000
APP_NAME=PRISM

# JWT secret (change in production)
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# SMTP (optional — emails log to console in dev without SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@prism.local

# ScraperAPI.com key (required for POST /api/website-scraper)
SCRAPERAPI_KEY=261f7c997f112d4b8f505b012fb6f8e6

# Optional — protects POST /api/scraper ingest when set (x-scraper-key header)
SCRAPER_API_KEY=261f7c997f112d4b8f505b012fb6f8e6

# Node environment
NODE_ENV=development
