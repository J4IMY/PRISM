# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prism

# App URL (used in verification emails and OAuth redirects)
APP_URL=http://localhost:5000
APP_NAME=PRISM

# JWT secret (change in production)
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Google OAuth (optional — without these, login shows "not configured")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (optional in dev — verification/reset links are logged to the console
# and shown in the UI; no outbound email is sent unless SMTP_USER/SMTP_PASS are set.
# Set SMTP_FORCE=true to opt into Ethereal test SMTP when creds are empty.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FORCE=
EMAIL_FROM=noreply@prism.local

# Scraper API key (optional — protects POST /api/scraper)
SCRAPER_API_KEY=

# Node environment
NODE_ENV=development
