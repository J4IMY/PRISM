# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prism

# App URL (used in verification emails and OAuth redirects)
APP_URL=http://localhost:5000
APP_NAME=PRISM

# JWT secret (change in production)
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Google OAuth (optional — without these, login shows "not configured")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (optional — uses Resend if RESEND_API_KEY is set instead)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FORCE=
EMAIL_FROM=noreply@prism.local

# Resend (recommended for production on Vercel — requires only an API key)
RESEND_API_KEY=

# ScraperAPI.com key (required for POST /api/website-scraper)
SCRAPERAPI_KEY=

# Optional — protects POST /api/scraper ingest when set (x-scraper-key header)
SCRAPER_API_KEY=

# Node environment
NODE_ENV=development
